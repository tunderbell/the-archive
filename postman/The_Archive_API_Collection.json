  "item": [
    {
      "name": "1. Terminal & APEX Commands",
      "item": [
        {
          "name": "Execute Command (Status)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"status\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/terminal/execute",
              "host": ["{{base_url}}"],
              "path": ["api", "terminal", "execute"]
            },
            "description": "Executes a synchronous CLI command (e.g. status, sys, help, list) and returns output."
          }
        },
        {
          "name": "Execute Command (Help)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"help\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/terminal/execute",
              "host": ["{{base_url}}"],
              "path": ["api", "terminal", "execute"]
            }
          }
        },
        {
          "name": "Create Custom Alias (Tier 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"alias quick-sys=\\\"status\\\" --desc \\\"Quick status check\\\"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/terminal/execute",
              "host": ["{{base_url}}"],
              "path": ["api", "terminal", "execute"]
            }
          }
        },
        {
          "name": "List User Aliases",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"aliases\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/terminal/execute",
              "host": ["{{base_url}}"],
              "path": ["api", "terminal", "execute"]
            }
          }
        },
        {
          "name": "Execute Pipeline (Tier 2 '&&')",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"status && help\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/terminal/execute",
              "host": ["{{base_url}}"],
              "path": ["api", "terminal", "execute"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Scraper Engine",
      "item": [
        {
          "name": "Register Site Template (AsuraScans Recipe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domainName\": \"asurascans.com\",\n  \"name\": \"Asura Scans\",\n  \"titleSelector\": \"h1.entry-title\",\n  \"authorSelector\": \".author-content a\",\n  \"descriptionSelector\": \".entry-content p\",\n  \"coverImageSelector\": \".thumb img\",\n  \"chapterListSelector\": \"#chapterlist li a\",\n  \"chapterTitleSelector\": \".chapternum\",\n  \"imageSelector\": \"#readerarea img\",\n  \"rateLimitMs\": 1500,\n  \"requiresJs\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/scraper/template",
              "host": ["{{base_url}}"],
              "path": ["api", "scraper", "template"]
            }
          }
        },
